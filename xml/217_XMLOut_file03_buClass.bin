<data id="番外篇-补充剧情" cnName="番外篇-补充剧情" author="L刘大将军">
  <info>作为主线、支线和外传的补充，讲述了关于各个角色的故事。
	  因欣赏“倩友小萌新”的系列作品而做的部分补充。
	  友情提示：此类剧情仅是个人想法，有什么好的建议请在B站留言。感谢！
	  推荐：关闭P1的AI功能，默认小白档游玩，其余角色P1档可能会出现bug</info>
  <father name="normal" cn="关卡">
    <gather>
      <level name="主角篇-悠闲生活" cnName="主角篇-悠闲生活" descrip="爆枪小队的前传，主角的绿岛生活，悠然自得，可身边总有妈妈的唠叨。">
        <sceneLabel>GreenTown1</sceneLabel>
        <info noTreasureB="1" firstLostB="1" noVehicleB="1" noDeviceB="1" noMoreB="1" mustSingleB="1" music="music_sky" noPropsB="1" enemyLv="1"/>
        <drop noB="1"/>
        <fixed target="GreenTown1" rectG="all" unitG="before"/>
        <unitG>
          <allDefault/>
          <unitOrder id="we1" camp="we">
            <unit num="1" cnName="玉晴" aiOrder="followBodyAttack:p1" skillArr="State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit num="1" lifeMul="6" dpsMul="5000" cnName="本我" skillArr="noArmsShoot"/>
          </unitOrder>
        </unitG>
        <rectG/>
        <eventG>
          <group>
            <event>
              <condition/>
              <order>createUnit:we2; r_birth</order>
              <order>heroEverParasitic:本我</order>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
            </event>
            <event>
              <condition/>
              <order>openInput</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
            </event>
            <event>
              <condition delay="1"/>
            </event>
            <event>
              <condition delay="1">enemyNumber:less_1</condition>
              <order>createUnit:we1; r_birth</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
            </event>
            <event>
              <condition delay="2"/>
              <order>say; startList:s3</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s4</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
              <order>task:now; complete</order>
              <order>level; showPointer:r_over</order>
            </event>
          </group>
        </eventG>
      </level>
    </gather>
  </father>
  <father name="normal" cn="关卡">
    <gather>
      <level name="主角篇-烦恼" cnName="主角篇-烦恼" descrip="妈妈的唠叨实在让主角难以接受，烦恼过多，离家的念头由此萌生。">
        <sceneLabel>GreenTown1</sceneLabel>
        <info noTreasureB="1" firstLostB="1" noVehicleB="1" noDeviceB="1" noMoreB="1" mustSingleB="1" music="music_sky" noPropsB="1" enemyLv="1"/>
        <drop noB="1"/>
        <fixed target="GreenTown1" rectG="all" unitG="before"/>
        <unitG>
          <allDefault/>
          <unitOrder id="we1" camp="we">
            <unit num="1" cnName="玉晴" aiOrder="followBodyAttack:p1" skillArr="State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit num="1" lifeMul="6" dpsMul="5000" cnName="本我" skillArr="noArmsShoot"/>
          </unitOrder>
        </unitG>
        <rectG/>
        <eventG>
          <group>
            <event>
              <condition/>
              <order>createUnit:we1; r_birth</order>
              <order>createUnit:we2; r_birth</order>
              <order>heroEverParasitic:本我</order>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
            </event>
            <event>
              <condition/>
              <order>openInput</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition delay="0.01">say:listOver</condition>
              <order>alert:yes; 获得物品：巨量的家庭作业。</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition delay="0.01">say:listOver</condition>
              <order>body:玉晴; rangeLimit:close</order>
              <order>body:玉晴; followPoint:r_back</order>
            </event>
            <event>
              <condition delay="3"/>
              <order>say; startList:s3</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
              <order>task:now; complete</order>
              <order>level; showPointer:r_over</order>
            </event>
          </group>
        </eventG>
      </level>
    </gather>
  </father>
  <father name="normal" cn="关卡">
    <gather>
      <level name="主角篇-离家" cnName="主角篇-离家" descrip="忍耐终于到了极限，情绪激动之下选择离开绿岛。母亲再次威胁自己，更坚定了主角离家出走的决定。">
        <sceneLabel>GreenIs1</sceneLabel>
        <info noTreasureB="1" firstLostB="1" noVehicleB="1" noDeviceB="1" noMoreB="1" mustSingleB="1" music="music_sky" noPropsB="1" enemyLv="1"/>
        <drop noB="1"/>
        <fixed target="GreenTown1" rectG="all" unitG="before"/>
        <unitG>
          <allDefault/>
          &gt;
          <unitOrder id="we1" camp="we">
            <unit num="1" lifeMul="6" dpsMul="5000" cnName="本我" skillArr="noArmsShoot"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit num="1" cnName="玉晴" aiOrder="followBodyAttack:p1" skillArr="State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we3" camp="we">
            <unit cnName="潜行者"/>
          </unitOrder>
        </unitG>
        <rectG/>
        <eventG>
          <group>
            <event>
              <condition/>
              <order>addWeather:rain; 3:99999</order>
              <order>createUnit:we3; r_birth</order>
              <order>body:潜行者; flipToRight</order>
              <order>body:潜行者; setXY:188,910</order>
              <order>createUnit:we1; 542,670</order>
              <order>heroEverParasitic:本我</order>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
            </event>
            <event>
              <condition/>
              <order>openInput</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition delay="0.01">say:listOver</condition>
            </event>
            <event>
              <condition>bodyGap:less_70; 本我:潜行者</condition>
              <order>body:本我; addEffectPosition:oreBombShowFlower</order>
              <order>body:本我; toDel</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>body:潜行者; rangeLimit:close</order>
              <order>body:潜行者; followPoint:-393,-45</order>
            </event>
            <event>
              <condition delay="1"/>
            </event>
            <event>
              <order>createUnit:we2; 3542,670</order>
              <order>clearHeroParasitic</order>
              <order>heroEverParasitic:玉晴</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition delay="0.1">say:listOver</condition>
              <order>task:now; complete</order>
              <order>level; showPointer:r_over</order>
            </event>
          </group>
        </eventG>
      </level>
    </gather>
  </father>
  <father name="normal" cn="关卡">
    <gather>
      <level name="主角篇-建设高地" cnName="主角篇-建设高地" descrip="作为拥有绝对优势的高地，将作为爆枪小队新的据点，代号—战斧。">
        <!-- 发兵集************************************************ -->
        <info enemyLv="99" noMoreB="1" noVehicleB="1" noTreasureB="1" noPropsB="1" mustSingleB="1" noDeviceB="1"/>
        <sceneLabel>MainUpland</sceneLabel>
        <!-- 发兵集************************************************ -->
        <unitG>
          <allDefault aiOrder="patrolGlobal" noSuperB="1"/>
          <unitOrder id="we1" camp="we">
            <unit cnName="本我" dpsMul="350" lifeMul="0.5" dieGotoState="stru" armsRange="lightCone" skillArr="groupLight_hero_7,hiding_hero_3,jumpNumAdd1,State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit cnName="小樱" dpsMul="100" lifeMul="0.3" dieGotoState="stru" skillArr="jumpNumAdd1" armsRange="lightCone" aiOrder="followBodyAttack:本我"/>
            <unit cnName="文杰表哥" dpsMul="3000" lifeMul="0.3" dieGotoState="stru" skillArr="jumpNumAdd1" armsRange="lightCone" aiOrder="followBodyAttack:小樱"/>
            <unit cnName="藏师将军" dpsMul="100" lifeMul="0.3" dieGotoState="stru" skillArr="jumpNumAdd1" armsRange="lightCone" aiOrder="followBodyAttack:文杰表哥"/>
            <unit cnName="心零" dpsMul="100" lifeMul="0.3" dieGotoState="stru" skillArr="jumpNumAdd1" armsRange="lightCone" aiOrder="followBodyAttack:藏师将军"/>
            <unit cnName="天鹰小美" dpsMul="100" lifeMul="0.3" dieGotoState="stru" skillArr="jumpNumAdd1" armsRange="lightCone" aiOrder="followBodyAttack:文杰表哥"/>
          </unitOrder>
        </unitG>
        <!-- 事件集************************************************ -->
        <eventG>
          <group>
            <event>
              <condition/>
              <order>openInput</order>
              <order>recoverAllHeroHead</order>
              <order>noWearShop</order>
              <order>playMusic; music_face:funny</order>
            </event>
            <event>
              <condition/>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
              <order>createUnit:we1; r_birth</order>
              <order>createUnit:we2; r_birth</order>
              <order>heroEverParasitic:本我</order>
            </event>
            <event id="e1_1">
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
