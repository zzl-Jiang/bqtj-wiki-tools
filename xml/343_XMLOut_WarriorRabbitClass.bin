<?xml version="1.0" encoding="utf-8" ?>
<data>
	<father name="pet" cnName="尸宠">
		<body name="武者兔"  shell="metal">
			
			<name>WarriorRabbit</name>
			<cnName>武者兔</cnName>
			<raceType>robot</raceType>
			<swfUrl>swf/pet/WarriorRabbit.swf</swfUrl>
			<!-- 基本系数 -->
			<lifeRatio>1</lifeRatio>
			<!-- 图像 -->
			<headIconUrl>BodyImg/WarriorRabbit_icon</headIconUrl>
			<imgType>normal</imgType>
			<imgArr>
				stand,move,run
				,normalAttack,shootAttack,shellingAttack
				,hurt1,die1
				,__jumpUp,jumpUp,jumpUp__jumpDown,jumpDown,jumpDown__
				,__fill1_Up,fill1_Up,fill1_Up__fill1_Down,fill1_Down,fill1_Down__die1
			</imgArr>
			<!-- 碰撞体积 -->
			<hitRect>-14,-76,28,76</hitRect>
			<!-- 运动 -->
			<maxJumpNum>1</maxJumpNum>
			<runStartVx>8</runStartVx>
			<maxVx>10</maxVx>
			<!-- AI属性 -->
			<nextAttackTime>0</nextAttackTime>
			<extraAIClassLabel></extraAIClassLabel>
			<!-- 攻击数据 -->
			<hurtArr>
				<hurt><cn>激光剑</cn>
					<imgLabel>normalAttack</imgLabel>
					<hurtRatio>2.5</hurtRatio>
					<hitImgUrl name="purpleHit"/>
				</hurt>
				<hurt><cn>炮击</cn>
					<imgLabel>shootAttack</imgLabel>
					<hurtRatio>2</hurtRatio>
					<bulletLabel>WarriorRabbit_1</bulletLabel>
					<grapRect>-631,-166,476,318</grapRect>
				</hurt>
				<hurt info="不加入ai选择-炮轰">
					<imgLabel>shellingAttack</imgLabel><noAiChooseB>1</noAiChooseB>
					<bulletLabel>WarriorRabbitShelling</bulletLabel>
					<grapRect>-400,-111,100,105</grapRect>
					<hurtRatio>2</hurtRatio>
				</hurt>
			</hurtArr>
		</body>	
	</father>
	<father type="pet" cnName="武者兔">
		<bullet>
			<name>WarriorRabbit_1</name>
			<cnName>武者兔-射击</cnName><noMagneticB>1</noMagneticB>
			<!--基本属性------------------------------------------------------------ -->
			<bulletLife>3</bulletLife>
			<bulletWidth>40</bulletWidth>
			<hitType>rect</hitType>
			<!--攻击时的属性------------------------------------------------------------ -->
			<attackGap>0.6</attackGap>
			<attackDelay>0.3</attackDelay>
			<bulletAngle>180</bulletAngle>
			<bulletAngleRange>30</bulletAngleRange>
			<bulletNum>1</bulletNum>				
			<!--特殊属性------------------------------------------------------------ -->	
			<penetrationGap>1000</penetrationGap>
			<!--运动属性------------------------------------------------------------ -->	
			<shootPoint>-68,-28</shootPoint>
			<bulletSpeed>25</bulletSpeed>
			<followD value="0.5" noLM="1" />	<!-- 跟踪 -->
			<!--图像动画属性------------------------------------------------------------ -->
			<flipX>1</flipX>
			<bulletImgUrl name="DollRabbit_1"/>
			<hitImgUrl name="DollRabbitHit"/><!-- 子弹图像【必备】 -->
		</bullet>
		<bullet cnName="勇者兔-炮轰">
			<name>WarriorRabbitShelling</name>
			<cnName>武者兔-炮轰</cnName><noMagneticB>1</noMagneticB>
			<!--基本属性------------------------------------------------------------ -->
			<bulletLife>3</bulletLife>
			<bulletWidth>40</bulletWidth>
			<hitType>rect</hitType>
			<!--攻击时的属性------------------------------------------------------------ -->
			<attackGap>0.9</attackGap>
			<attackDelay>0.5</attackDelay>
			<bulletAngle>120</bulletAngle>
			<bulletAngleRange>10</bulletAngleRange>
			
			<shootAngle>10</shootAngle>
			<bulletNum>2</bulletNum>				
			<shootNum>3</shootNum>	
			<shootGap>0.166</shootGap>
			<!--特殊属性------------------------------------------------------------ -->	
			<penetrationGap>1000</penetrationGap>
			<!--运动属性------------------------------------------------------------ -->	
			<shootPoint>-38,-196</shootPoint>
			<bulletSpeed>25</bulletSpeed>
			<followD value="1" noLM="1" />	<!-- 跟踪 -->
			<!--图像动画属性------------------------------------------------------------ -->
			<flipX>1</flipX>
			<bulletImgUrl name="DollRabbit_1"/>
			<hitImgUrl name="DollRabbitHit"/><!-- 子弹图像【必备】 -->
		</bullet>
	</father>	
	<father name="petBodySkill">
		
		<skill name="武者之心">
			<name>WarriorRabbitHeart</name><noBeClearB>1</noBeClearB>
			<cnName>武者之心</cnName><noRandomListB>1</noRandomListB><ignoreImmunityB>1</ignoreImmunityB><noSkillDodgeB>1</noSkillDodgeB>
			<iconUrl>SkillIcon/WarriorRabbitHeart</iconUrl>
			<!--英雄技能属性------------------------------------------------------------ -->
			<changeText>额外造成[mul-1]的伤害</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType><changeHurtB>1</changeHurtB>
			<condition>hit</condition>
			<otherConditionArr>targetNoSpellImmunity</otherConditionArr>
			<target>target</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>changeHurtNoCondition</effectType>
			<mul>1.2</mul>
			<description>对没有技能免疫状态的敌人额外造成[mul-1]的伤害。</description>
			<growth>
				<skill><mul>1.2</mul></skill>
				<skill><mul>1.3</mul></skill>
				<skill><mul>1.4</mul></skill>
				<skill><mul>1.5</mul></skill>
				<skill><mul>1.6</mul></skill>
				<skill><mul>1.7</mul></skill>
				<skill><mul>1.8</mul></skill>
				<skill><mul>1.9</mul></skill>
				<skill><mul>2</mul></skill>
			</growth>
		</skill>
		
	</father>
</data>