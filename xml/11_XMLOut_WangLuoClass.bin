<?xml version="1.0" encoding="utf-8" ?>
<data>
	<father name="snake" cnName="血蟒">
		<body index="0" name="旺达" shell="normal">
			
			<name>WangLuo</name><movieLink>XiaoHu</movieLink>
			<cnName>旺达</cnName>
			<raceType>human</raceType>
			<swfUrl>swf/hero/WangLuo.swf</swfUrl>
			<!-- 基本系数 -->
			<showLevel>9999</showLevel>
			<headIconUrl>IconGather/WangLuo</headIconUrl>
			<lifeBarExtraHeight>-20</lifeBarExtraHeight>
			<!-- 碰撞体积 -->
			<hitRect>-12, -90, 24, 90</hitRect><!-- 站立碰撞体积-->
			<squatHitRect>-12,-50,24,50</squatHitRect><!-- 下蹲碰撞体积-->
			<hurtRectArr>-15,-38,30,38</hurtRectArr> <!-- 要害受伤体积-->
			<hurtRectArr>-12, -100, 24, 95</hurtRectArr> <!-- 站立受伤体积-->
			<hurtRectArr>-12, -50, 24, 50</hurtRectArr> <!-- 下蹲受伤体积-->
			<!-- 运动 -->
			<maxVx>11</maxVx>
			<squatMaxVx>5</squatMaxVx>
			<maxJumpNum>2</maxJumpNum>
			<flyType>space</flyType><motionD F_AIR="6" />
			<!-- AI属性 -->
			<armsNumber>4</armsNumber><!-- 武器个数 -->
			<randomArmsRange>redFireE,yearCattleE,iceConeE,yearDragonE</randomArmsRange>
			<!-- 技能 -->
			<skillArr></skillArr>
			<bossSkillArr>defence500,wangPartner,weatherByGun,thunderEffectMe,snowEffect,heatEffect,acidrainEffect,gunReloadSwap,underToLand,shootSpeedWang,spellImmunityMax,KingRabbitTreater,killPet,noUnderMulHurt</bossSkillArr>
		</body>
		
				
				
	</father>
	
	
	<father name="enemy">
		<skill>
			<name>weatherByGun</name>
			<cnName>气象召唤</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><everNoClearB>1</everNoClearB>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>add</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType>
			<effectType>weatherByGun</effectType><effectFather>snake</effectFather>
			<duration>999999</duration>
			<pointEffectImg name="addWeather"/>
			<description>根据切换的武器召唤对应的天气。</description>
		</skill>
		<skill>
			<name>wangPartner</name><noCopyB>1</noCopyB>
			<cnName>人偶之印</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB><noBeClearB>1</noBeClearB>
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>interval</condition>
			<target>me,range,enemy</target>
			
			<addType>state</addType>
			<effectType>wangPartner</effectType><effectFather>snake</effectFather>
			<mul>0.4</mul>
			<intervalT>0.1</intervalT>
			<duration>0.3</duration>
			<range>999999</range>
			<otherEffectImg name="hideEffect"/><!-- 瞬移特效 -->
			<description>将除P1之外的持枪敌人缩小成玩偶大小，同时使其无法动弹，且失去攻击能力。</description>
		</skill>
		<skill><!-- dps -->
			<name>shootSpeedWang</name>
			<cnName>高射速</cnName><noBeClearB>1</noBeClearB><everNoClearB>1</everNoClearB><ignoreNoSkillB>1</ignoreNoSkillB>
			
			<conditionType>passive</conditionType>
			<condition>add</condition>
			<target>me</target>
			
			<addType>state</addType>
			<effectType>attackAndReloadSpeedMul</effectType>
			<mul>2</mul>
			<secMul>1</secMul>
			<duration>999999</duration>
			<description>增加[mul-1]的射击速度，和[secMul-1]的换弹速度。</description>
		</skill>
		<![CDATA[
		<skill>
			<name>wangPartner</name>
			<cnName>终极歧视</cnName>
			<wantDescripB>1</wantDescripB><noCopyB>1</noCopyB>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>allHit</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>wangPartner</effectType><effectFather>snake</effectFather>
			<mul>1000</mul>
			<!--图像------------------------------------------------------------ -->
			<description>对除P1之外的持枪敌人造成[mul]的伤害。</description>
		</skill>
		]]>
		<skill>
			<name>heatEffect</name><noCopyB>1</noCopyB>
			<cnName>高温效应</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB><noBeClearB>1</noBeClearB>
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>interval</condition>
			<otherConditionArr>isEffectWeather,isGroundB,targetNoDelay_noUnderAllB</otherConditionArr>
			<conditionString>heat</conditionString>
			<target>me,range,enemy</target>
			<addType>state</addType>
			<effectType>heatEffect</effectType><effectFather>snake</effectFather>
			<mul>0.2</mul><!-- 着火后，每0.1秒造成一次0.1倍的dpsFactor伤害 -->
			<extraValueType>meDpsFactor</extraValueType>
			<intervalT>0.5</intervalT>
			<value>2.5</value><!-- 站在地面上几秒后着火-->
			<duration>3</duration><!-- 着火持续时间 -->
			<range>999999</range>
			<stateEffectImg name="footSmoke"/><!-- 冒烟特效 -->
			<otherEffectImg name="WatchEagle_wind_hit"/><!-- 爆火特效 -->
			<pointEffectImg name="footFireBig"/><!-- 着火特效 -->
			<description>高温天气降临时，敌人的双脚触地超过[value]秒就会被点燃，火焰将不断减少敌人的生命值。火焰消失方法：目标悬空[duration]秒或高温天气结束超过[duration]秒。</description>
		</skill>
		
		<skill>
			<name>acidrainEffect</name><noCopyB>1</noCopyB>
			<cnName>酸雨效应</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB><noBeClearB>1</noBeClearB>
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>interval</condition>
			<otherConditionArr>isEffectWeather,targetIsHero,targetNoDelay_noUnderAllB</otherConditionArr>
			<conditionString>acidrain</conditionString>
			<target noExistB="1">me,range,enemy</target>
			<addType>state</addType>
			<effectType>acidrainEffect</effectType><effectFather>snake</effectFather>
			<intervalT>0.5</intervalT>
			<duration>0.6</duration>
			<range>999999</range>
			<stateEffectImg name="gunSmokeGreen"/><!-- 冒烟特效 -->
			<description>酸雨天气降临时，敌人的枪械将被腐蚀至无法使用。</description>
		</skill>
		
		<skill>
			<name>snowEffect</name><noCopyB>1</noCopyB>
			<cnName>冰雪效应</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB><noBeClearB>1</noBeClearB>
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>interval</condition>
			<otherConditionArr>isEffectWeather,targetNoIsVehicle,targetNoDelay_noUnderAllB</otherConditionArr>
			<conditionString>snow</conditionString>
			<target noExistB="1">me,range,enemy</target>
			
			<addType>state</addType><overlyingB>1</overlyingB>
			<effectType>snowEffect</effectType><effectFather>snake</effectFather>
			<value>10</value><!-- 叠加多少层后冻住 -->
			<intervalT>0.3</intervalT><!-- 多少秒叠一层 -->
			<duration>15</duration>
			<range>999999</range>
			<stateEffectImg name="frozenFrame"/>
			<passiveSkillArr>snowEffectUnder,snowEffectUse</passiveSkillArr>
			<description>冰雪天气降临时，敌人（除了载具外）身上将不断被叠上冰层，直至无法动弹。融化自身冰层方法：使用火系武器射击、被火系武器攻击，或者高温天气来临。</description>
		</skill>
				<skill>
					<name>snowEffectUnder</name>
					<cnName>受到火系攻击</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB>
					<conditionType>passive</conditionType>
					<condition>underAllHit</condition>
					<otherConditionArr>hurtKind,targetBuffOverlyingNumMore1</otherConditionArr>
					<conditionString>fire</conditionString>
					<target>me</target>
					<addType>instant</addType>
					<effectType>addStateOverlyingNum</effectType>
					<valueString>snowEffect</valueString>
					<value>-3</value><!-- 单次减少层级 -->
					<minTriggerT>0.3</minTriggerT><!-- 触发时间越短，消除越快 -->
					<targetEffectImg name="iceWhiteSmoke"/>
					<description>受到火系攻击时，减少冰雪效应。</description>
				</skill>
				<skill>
					<name>snowEffectUse</name>
					<cnName>使用火系武器</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB>
					<conditionType>passive</conditionType>
					<condition>heroShoot</condition>
					<otherConditionArr>targetArmsHurtKind,targetBuffOverlyingNumMore1</otherConditionArr>
					<conditionString>fire</conditionString>
					<target>me</target>
					<addType>instant</addType>
					<effectType>addStateOverlyingNum</effectType>
					<valueString>snowEffect</valueString>
					<value>-3</value><!-- 单次减少层级 -->
					<minTriggerT>0.3</minTriggerT>
					<targetEffectImg name="iceWhiteSmoke"/>
					<description>使用火系攻击时，减少冰雪效应。</description>
				</skill>
				
		<skill>
			<name>thunderEffectMe</name><noCopyB>1</noCopyB>
			<cnName>雷电效应</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB><everNoClearB>1</everNoClearB>
			<conditionType>passive</conditionType><showInLifeBarB>1</showInLifeBarB><wantDescripB>1</wantDescripB>
			<condition>interval</condition>
			<otherConditionArr>isEffectWeather</otherConditionArr>
			<conditionString>thunder</conditionString>
			<target>me</target>
			
			<addType>state</addType>
			<effectType>thunderEffectMe</effectType><effectFather>snake</effectFather>
			<mul>1</mul><!--闪电击中后造成一次5倍的dpsFactor伤害。世界伤害，无视任何防御技能。 -->
			<extraValueType>meDpsFactor</extraValueType>
			
			<intervalT>0.2</intervalT>
			<duration>0.3</duration>
			<pointEffectImg name="purpleLightning"/>
			<otherEffectImg name="thunderHit"/><!-- 雷电击中音效 -->
			<description>雷电天气降临时，头顶没有地形遮盖、或者持有电系武器的敌人，将会被雷电击中并造成重大伤害（无视任何减伤技能）。</description>
		</skill>
	</father>
	
	<father type="weather" cnName="气象枪">
		<bullet cnName="冰锥E" name="iceConeE"  kind="water">
			<name>iceConeE</name><noMagneticB>1</noMagneticB>
			<cnName>冰锥E</cnName><dpsMul>8</dpsMul>
			<!--随机属性------------------------------------------------------------ -->
			<!--基本-->
			<capacity>25</capacity>
			<attackGap>0.4</attackGap>
			<reloadGap>1</reloadGap>
			<shakeAngle>0</shakeAngle>
			<bulletWidth>35</bulletWidth>
			<bulletNum>1</bulletNum>				
			<gunNum>1</gunNum>
			<!--武器属性------------------------------------------------------------ -->
			<armsArmMul>0.9</armsArmMul>
			<upValue>5</upValue>
			<shootShakeAngle>30</shootShakeAngle>
			<shootRecoil>12</shootRecoil>
			<screenShakeValue>16</screenShakeValue>
			<!--基本属性------------------------------------------------------------ -->
			<bulletLife>2</bulletLife>
			<hitType>rect</hitType>
			<!--运动属性------------------------------------------------------------ -->	
			<bulletSpeed>35</bulletSpeed>
			<!--特殊------------------------------------------------------------ -->
			<skillArr>Hit_Spurting_ArmsSkill</skillArr>
			<!--图像动画属性------------------------------------------------------------ -->
			<iconUrl>specialGun/iceConeIcon</iconUrl>
			<flipX>1</flipX>
			<bulletImgUrl name="iceConeBullet"/>
			<hitImgUrl name="iceConeHit" /><!-- 子弹图像【必备】 -->
			<fireImgUrl name="iceConeFire"/>
			<shootSoundUrl>sound/snowHit</shootSoundUrl>
			<!--图像范围------------------------------------------------------------ -->
			<bodyImgRange>specialGun/iceCone</bodyImgRange>
			<bulletImgRange>specialGun/bullet</bulletImgRange>
			<description></description>
		</bullet>
	</father>
	
	<father  type="rocket" cnName="火炮-特殊">
		<bullet cnName="丑牛E"  kind="poison" name="yearCattleE">
			<name>yearCattleE</name><noMagneticB>1</noMagneticB>
			<cnName>丑牛E</cnName><dpsMul>5</dpsMul>
			<!--随机属性------------------------------------------------------------ -->
			<!--基本-->
			<capacity>15</capacity>
			<attackGap>0.8</attackGap>
			<reloadGap>1</reloadGap>
			<shakeAngle>0</shakeAngle>
			<bulletWidth>30</bulletWidth>
			<bulletNum>1</bulletNum>				
			<gunNum>1</gunNum>
			
			<!--武器属性------------------------------------------------------------ -->
			<armsArmMul>0.65</armsArmMul>
			<upValue>5</upValue>
			<shootShakeAngle>40</shootShakeAngle>
			<shootRecoil>12</shootRecoil>
			<screenShakeValue>16</screenShakeValue>
			<!--基本属性------------------------------------------------------------ -->
			<noShakeTime>0.5</noShakeTime>
			<bulletLife>2</bulletLife>
			<hitType>rect</hitType>
			<!--攻击时的属性------------------------------------------------------------ -->
			<!--运动属性------------------------------------------------------------ -->	
			<bulletSpeed>40</bulletSpeed>
			<!--特殊------------------------------------------------------------ -->
			<skillArr>Hit_Poison_ArmsSkill,Hit_Spurting_ArmsSkill</skillArr>
			<godSkillArr>yearCattleSkill</godSkillArr>
			<!--图像动画属性------------------------------------------------------------ -->
			<iconUrl>specialGun/yearCattleIcon</iconUrl>
			<flipX>1</flipX>
			<bulletImgUrl con="add" raNum="1">specialGun/yearCattleBullet</bulletImgUrl>
			<hitImgUrl con="add" soundUrl="HugePoison/shoot_hit">boomEffect/posion1</hitImgUrl><!-- 子弹图像【必备】 -->
			<smokeImgUrl con="filter" raNum="30">skillEffect/poisonClaw_enemy</smokeImgUrl><!-- 子弹尾烟效果（默认为空） -->
			<fireImgType></fireImgType>
			<shootSoundUrl>specialGun/yearCattleSound</shootSoundUrl>
			<!--图像范围------------------------------------------------------------ -->
			<bodyImgRange>specialGun/yearCattle</bodyImgRange>
			<bulletImgRange>specialGun/bullet</bulletImgRange>
		</bullet>
		
	</father>
	<father type="lightning" cnName="闪电枪">
		<bullet name="yearDragonE">
			<name>yearDragonE</name>
			<cnName>辰龙E</cnName><dpsMul>3</dpsMul>
			<whippB>0</whippB>
			<!--基本-->
			<capacity>12</capacity>
			<attackGap>1</attackGap>
			<reloadGap>1</reloadGap>
			<shakeAngle>1</shakeAngle>
			<bulletWidth>900</bulletWidth>
			<bulletNum>10</bulletNum>				
			<shootAngle>7</shootAngle>				
			<beatBack>2</beatBack>
			<targetShakeValue>10</targetShakeValue>
			<!--特殊------------------------------------------------------------ -->
			
			<skillArr>Hit_Spurting_ArmsSkill</skillArr>
			<godSkillArr>yearDragonSkill</godSkillArr>
			<!--武器属性------------------------------------------------------------ -->
			<hurtRatio>4</hurtRatio>
			<gunNum>1</gunNum>
			<armsArmMul>0.6</armsArmMul>
			<armsWeight>5</armsWeight>
			<upValue>8</upValue>
			<shootShakeAngle>70</shootShakeAngle>
			<shootRecoil>10</shootRecoil>
			<screenShakeValue>15</screenShakeValue>
			<!--基本属性------------------------------------------------------------ -->
			<noShakeTime>0.5</noShakeTime>
			<bulletLife>0.001</bulletLife>
			<hitType>longLine</hitType>
			<!--特殊------------------------------------------------------------ -->
			<!--图像动画属性------------------------------------------------------------ -->
			<iconUrl>specialGun/yearDragonIcon</iconUrl>
			<shootSoundUrl>sound/lightningShoot</shootSoundUrl>
			<flipX>1</flipX>
			<bulletImgUrl raNum="30" con="filter" len="50" time="0.03" waveAn="45" everFleshB="1" imgDieType="ranStop">generalEffect/lineLightning</bulletImgUrl>
			<hitImgUrl con="add">bulletHitEffect/fitHit</hitImgUrl>
			<fireImgType></fireImgType>
			<!--图像范围------------------------------------------------------------ -->
			<bodyImgRange>specialGun/yearDragon</bodyImgRange>
			<bulletImgRange>specialGun/bullet</bulletImgRange>
			<description></description>
		</bullet>
	</father>
	<father  type="rocket">
		<bullet cnName="猩焰E" name="redFireE" kind="fire" >
			<name>redFireE</name><noMagneticB>1</noMagneticB>
			<cnName>猩焰E</cnName><dpsMul>3</dpsMul>
			<!--随机属性------------------------------------------------------------ -->
			<!--基本-->
			<capacity>24</capacity>
			<attackGap>0.7</attackGap>
			<reloadGap>1</reloadGap>
			<shakeAngle>0</shakeAngle>
			<bulletWidth>30</bulletWidth>
			<bulletNum>1</bulletNum>				
			<!--武器属性------------------------------------------------------------ -->
			<armsArmMul>0.65</armsArmMul>
			<upValue>5</upValue>
			<shootShakeAngle>40</shootShakeAngle>
			<shootRecoil>12</shootRecoil>
			<screenShakeValue>16</screenShakeValue>
			<!--基本属性------------------------------------------------------------ -->
			<noShakeTime>0.5</noShakeTime>
			<bulletLife>2</bulletLife>
			<hitType>rect</hitType>
			<!--运动属性------------------------------------------------------------ -->	
			<bulletSpeed>35</bulletSpeed>
			<!--特殊------------------------------------------------------------ -->
			<boomD  bodyB="1" floorB="1" selfB="1" radius="150"/>
			<skillArr>Hit_blindness_ArmsSkill,Hit_Spurting_ArmsSkill</skillArr>
			<godSkillArr>Hit_imploding_godArmsSkill,redFireSkill</godSkillArr>
			<!--图像动画属性------------------------------------------------------------ -->
			<iconUrl></iconUrl>
			<flipX>1</flipX>
			<bulletImgUrl con="add" raNum="30">bullet/fireball</bulletImgUrl>
			<hitImgUrl name="redFire_hit">boomEffect/boom2</hitImgUrl><!-- 子弹图像【必备】 -->
			<hitFloorImgUrl name="redFire_hitFloor"></hitFloorImgUrl><!-- 子弹图像【必备】 -->
			<smokeImgUrl con="filter" raNum="30">bullet/fireballSmoke</smokeImgUrl><!-- 子弹尾烟效果（默认为空） -->
			<fireImgType></fireImgType>
			<shootSoundUrl>specialGun/redFire_sound</shootSoundUrl>
			<!--图像范围------------------------------------------------------------ -->
			<bodyImgRange>specialGun/redFire</bodyImgRange>
			<bulletImgRange>specialGun/bullet</bulletImgRange>
		</bullet>
	</father>
</data>