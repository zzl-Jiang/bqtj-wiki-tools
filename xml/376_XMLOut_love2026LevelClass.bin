	<father name="enemySkill">
		<skill>
			<name>love2026Skill</name>
			<cnName>七夕节</cnName>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>no</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>no</effectType>
			<stateEffectImg name="firePossession_target"/>
			<targetEffectImg name="timeCapsule"/>
			<otherEffectImg name="lineLightning"/>
