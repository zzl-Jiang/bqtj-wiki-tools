					<rect id="rwe2">1540,788,20,20</rect>
				</rectG>
				<eventG>
					<group>
						<event>
							<order>setNumber:min; 80</order><!-- 启动距离判断 -->
							<order>setNumber:max; 200</order><!-- 启动距离判断 -->
							
							<order>sceneScale:1</order>
							<order>createUnit:we1; rwe1</order>
							<order>createUnit:we2; rwe2</order>
							<order>setP1:文杰表哥</order>
							<order>onlySetP2:心零</order>
							<order>body:心零; closeAi</order>
							<order>body:心零; inKeySaveByType:single</order>
							<order>body:心零; setVX:9</order>
							<order>body:文杰表哥; setVX:10</order>
							
							<order>addEffectDropStop:heartTask; 1430,310</order>
							<order>addEffectDropStop:heartTask; 1570,310</order>
						</event>
						<event>
							<condition delay="0.5">number:greater_1; heart</condition>
							<order>task:now; complete</order>
							<order>alertSuccess; 相恋成功！:NewIcon/heart</order>
						</event>
						<event>
							<order>level; win</order>
						</event>
					</group>
					<group>
						<event>
							<condition delay="0.3">number:greater_200; gap</condition>
							<order>alertFail; 小白和心零距离太远，任务失败！</order>
						</event>
						<event>
							<order>level; fail</order>
						</event>
					</group>
				</eventG>
			</level>
			
