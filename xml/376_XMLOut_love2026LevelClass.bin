<?xml version="1.0" encoding="utf-8" ?>

<data id="love2026" cnName="七夕节2026" author="沃龙先生">
	<info></info>
	<father name="normal" cn="关卡">
		<gather>
			<level name="love2026_1" cnName="相遇">
				<info diy="love2026" unitAddType="noAll" noPropsB="1" noTreasureB="1" noAIB="1" mustSingleB="1" preSkillArr="love2026Skill" dropSmallMapB="1" />
				<drop noB="1" />
				<sceneLabel>XiFeng</sceneLabel>
				<!-- 发兵集************************************************ -->
				<unitG><allDefault aiOrder="patrolGlobal"></allDefault>
					<unitOrder id="we1" camp="we">
						<unit cnName="文杰表哥"/>
					</unitOrder>
					<unitOrder id="we2" camp="we">
						<unit cnName="心零"/>
					</unitOrder>
				</unitG>
				<rectG>
					<rect id="rwe1">800,558,20,20</rect>
					<rect id="rwe2">1000,1374,20,20</rect>
				</rectG>
				<eventG>
					<group>
						<event>
							<order>sceneScale:0.50</order>
							<order>createUnit:we1; rwe1</order>
							<order>createUnit:we2; rwe2</order>
							<order>setP1:文杰表哥</order>
							<order>onlySetP2:心零</order>
							<order>body:心零; closeAi</order>
							<order>body:心零; inKeySaveByType:single</order>
							<order>body:心零; setVX:10</order>
							<order>body:文杰表哥; setVX:10</order>
							
							<order>addEffectDropStop:heartTask; 1344,742</order>
							<order>addEffectDropStop:heartTask; 1163,830</order>
						</event>
						<event>
							<condition delay="0.5">number:greater_1; heart</condition>
							<order>task:now; complete</order>
							<order>alertSuccess; 相遇成功！:NewIcon/heart</order>
						</event>
						<event>
							<order>level; win</order>
						</event>
					</group>
				</eventG>
			</level>
			
			<level name="love2026_2" cnName="相恋">
				<info diy="love2026" unitAddType="noAll" noPropsB="1" noTreasureB="1" noAIB="1" mustSingleB="1" preSkillArr="love2026Skill" dropSmallMapB="1" />
				<drop noB="1" />
				<sceneLabel>YangMei</sceneLabel>
				<!-- 发兵集************************************************ -->
