<?xml version="1.0" encoding="utf-8" ?>
<data>
	<![CDATA[六周年已添加]]>
	<father name="heroSkill" cnName="英雄技能">
		<skill name="横扫">
			<name>spurtingLing</name>
			<cnName>横扫</cnName><ignoreImmunityB>1</ignoreImmunityB><ignoreNoSkillB>1</ignoreNoSkillB><noSkillDodgeB>1</noSkillDodgeB>
			<effectInfoArr>增加伤害输出</effectInfoArr>
			<!--触发条件与目标------------------------------------------------------------ -->
			<changeText>范围[range]码{n}最短触发间隔[minTriggerT]秒</changeText>
			<conditionType>passive</conditionType>
			<condition>hurt</condition>
			<target targetMustLiveB="1" noTargetB="1">target,range,enemy</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>spurtingLing</effectType>
			<extraValueType>hurtValue</extraValueType>
			<minTriggerT>2.4</minTriggerT>
			<firstTriggerT>4</firstTriggerT>
			<mul>1</mul>
			<range>350</range>
			<pointEffectImg name="orangeLightning"/>
			<description>对目标造成伤害时，将对目标周围[range]码的敌人造成同等伤害（无视减伤技能，无视免疫、技能免疫），对拥有副手、载具、尸宠、徒手敏感的敌人无效。最短触发间隔[minTriggerT]秒。{font color='#00FF00'}14级无需装备技能也会有技能效果。{/font}</description>
			<growth>
				<skill><range>350</range><minTriggerT>1.8</minTriggerT></skill>
				<skill><range>380</range><minTriggerT>1.7</minTriggerT></skill>
				<skill><range>410</range><minTriggerT>1.6</minTriggerT></skill>
				<skill><range>450</range><minTriggerT>1.5</minTriggerT></skill>
				<skill><range>500</range><minTriggerT>1.4</minTriggerT></skill>
				<skill><range>600</range><minTriggerT>1.3</minTriggerT></skill>
				<skill><range>700</range><minTriggerT>1.2</minTriggerT></skill>
				<skill><range>800</range><minTriggerT>1.1</minTriggerT></skill>
				<skill><range>900</range><minTriggerT>1.0</minTriggerT></skill>
				<skill><range>1000</range><minTriggerT>0.9</minTriggerT></skill>
				<skill><range>1200</range><minTriggerT>0.7</minTriggerT></skill>
				<skill><range>1500</range><minTriggerT>0.5</minTriggerT></skill>
				<skill><range>2000</range><minTriggerT>0.3</minTriggerT></skill>
				<skill><range>2000</range><minTriggerT>0.3</minTriggerT><noNeedEquipB>1</noNeedEquipB><changeText>无需装备技能也会有技能效果</changeText></skill>
			</growth>
		</skill>
		<skill name="湮灭">
			<name>toDelLing</name><noCopyB>1</noCopyB>
			<cnName>湮灭</cnName><ignoreImmunityB>1</ignoreImmunityB><noSkillDodgeB>1</noSkillDodgeB><ignoreNoSkillB>1</ignoreNoSkillB>
			<!--触发条件与目标------------------------------------------------------------ -->
			<changeText>概率[effectProArr.0]</changeText>
			<conditionType>passive</conditionType>
			<condition>killTarget</condition>
			<otherConditionArr>targetDieGotoStateDie,targetNoBoss,noUnionBattle,noTask</otherConditionArr>
			<target>target</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>toDel</effectType>
			<effectProArr>0.1</effectProArr>
			<![CDATA[<targetEffectImg name="shadowDie"/>]]>
			<description>杀死敌人（除了首领）时，有[effectProArr.0]的概率消除它的尸体。升至第10级时，队友杀敌也能消除尸体。任务、争霸中无效。</description>
			<growth>
				<skill><effectProArr>0.1</effectProArr></skill>
				<skill><effectProArr>0.2</effectProArr></skill>
				<skill><effectProArr>0.3</effectProArr></skill>
				<skill><effectProArr>0.4</effectProArr></skill>
				<skill><effectProArr>0.5</effectProArr></skill>
				<skill><effectProArr>0.6</effectProArr></skill>
				<skill><effectProArr>0.7</effectProArr></skill>
				<skill><effectProArr>0.8</effectProArr></skill>
				<skill><effectProArr>0.9</effectProArr></skill>
				<skill><effectProArr>1.0</effectProArr><changeText>概率[effectProArr.0]{n}队友杀敌也能消除尸体</changeText></skill>
			</growth>
		</skill>
		
		
		
		<skill name="攻防一体">
			<name>lifeAddHurtLing</name><iconUrl>SkillIcon/lifeAddHurtDR</iconUrl><wantDescripB>1</wantDescripB>
			<cnName>攻防一体</cnName><everNoClearB>1</everNoClearB><ignoreImmunityB>1</ignoreImmunityB><noSkillDodgeB>1</noSkillDodgeB><ignoreNoSkillB>1</ignoreNoSkillB>
			<effectInfoArr>增加伤害输出</effectInfoArr>
			<!--英雄技能属性------------------------------------------------------------ -->
			<changeText>增伤最高[mul]</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>add</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType>
			<effectType>lifeAddHurt</effectType>
			<value>0.0000004</value>
			<mul>0.05</mul>
			<duration>9999999</duration>
			<description>获得与角色生命值相关的增伤，增伤=生命值x0.00004%，最高[mul]，无视封锁。{font color='#00FF00'}14级无需装备技能也会有技能效果。{/font}</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><mul>0.10</mul></skill>
				<skill><mul>0.16</mul></skill>
				<skill><mul>0.22</mul></skill>
				<skill><mul>0.28</mul></skill>
				<skill><mul>0.34</mul></skill>
				<skill><mul>0.40</mul></skill>
				<skill><mul>0.50</mul></skill>
				<skill><mul>0.60</mul></skill>
				<skill><mul>0.70</mul></skill>
				<skill><mul>0.80</mul></skill>
				<skill><mul>0.90</mul></skill>
				<skill><mul>1.00</mul></skill>
				<skill><mul>1.10</mul></skill>
				<skill><mul>1.20</mul><noNeedEquipB>1</noNeedEquipB><changeText>增伤最高[mul]{n}无需装备技能也会有技能效果</changeText></skill>
			</growth>
		</skill>
		<skill name="整数增益">
			<name>integerHurtLing</name><iconUrl>SkillIcon/integerHurtDR</iconUrl><wantDescripB>1</wantDescripB>
			<cnName>整数增益</cnName><everNoClearB>1</everNoClearB><ignoreNoSkillB>1</ignoreNoSkillB>
			<effectInfoArr>增加伤害输出</effectInfoArr>
			<!--英雄技能属性------------------------------------------------------------ -->
			<changeText>提升[mul-1]的伤害{n}</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>add</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType>
			<effectType>integerHurt</effectType>
			<value>5</value>
			<mul>1.05</mul>
			<duration>9999999</duration>
			<!--图像------------------------------------------------------------ -->
			<stateEffectImg name="crazy_vehicle_hand"/>
			<![CDATA[<otherEffectImg name="murderous_hero_me"/>]]>
			<description>当剩余弹药为[value]的倍数时，角色将获得[mul-1]增伤状态（无视封锁）。注意，增伤效果是击中敌人时生效，不是在发射子弹时生效。{font color='#00FF00'}14级无需装备技能也会有技能效果。{/font}</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><mul>1.2</mul></skill>
				<skill><mul>1.3</mul></skill>
				<skill><mul>1.4</mul></skill>
				<skill><mul>1.5</mul></skill>
				<skill><mul>1.6</mul></skill>
				<skill><mul>1.7</mul></skill>
				<skill><mul>1.8</mul></skill>
				<skill><mul>2.0</mul></skill>
				<skill><mul>2.2</mul></skill>
				<skill><mul>2.4</mul></skill>
				<skill><mul>2.6</mul></skill>
				<skill><mul>2.8</mul></skill>
				<skill><mul>3.0</mul></skill>
				<skill><mul>3.0</mul><noNeedEquipB>1</noNeedEquipB><changeText>无需装备技能也会有技能效果</changeText></skill>
			</growth>
		</skill>
		
		
		
		
		<skill name="嘲讽">
			<name>tauntLing</name>
			<cnName>嘲讽</cnName><ignoreImmunityB>1</ignoreImmunityB><noSkillDodgeB>1</noSkillDodgeB><noBeClearB>1</noBeClearB>
			<effectInfoArr>增加防御力</effectInfoArr>
			<addD pro="cd" range="-1,-3" info="冷却时间[v]秒" />
			<cd>70</cd>
			<changeText>技能冷却时间：[cd]秒</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>active</conditionType>
			<condition>avtiveSkillCdOver</condition>
			<otherConditionArr>nearAttackTarget</otherConditionArr>
			<conditionRange>800</conditionRange>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType>
			<effectType>invincible</effectType>
			<duration>6</duration>
			<passiveSkillArr>tauntLingBack_link_1</passiveSkillArr>
			<linkArr>tauntLing_link</linkArr>
			<!--图像------------------------------------------------------------ --> 
			<meEffectImg soundUrl="sound/tauntLing" partType="mouth">skillEffect/screaming_hero</meEffectImg>
			<stateEffectImg partType="body" con="add">generalEffect/invincibleShield</stateEffectImg>
			<description>自身无敌[duration]秒，期间逼迫900码内的敌人攻击自己。更高等级技能将会反弹伤害给敌人。</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><cd>70</cd></skill>
				<skill><cd>65</cd></skill>
				<skill><cd>60</cd></skill>
				<skill><cd>55</cd></skill>
				<skill><cd>50</cd></skill>
				<skill><cd>45</cd></skill>
				<skill><cd>40</cd></skill>
				<skill><cd>35</cd></skill>
				<skill><cd>30</cd><passiveSkillArr>tauntLingBack_link_2</passiveSkillArr><changeText>反弹伤害倍数：0.5倍</changeText><description>自身无敌[duration]秒，期间逼迫900码内的敌人攻击自己，并把伤害反弹给敌人，伤害等于心零当前武器实际战斗力的0.5倍。</description></skill>
				<skill><cd>30</cd><passiveSkillArr>tauntLingBack_link_3</passiveSkillArr><changeText>反弹伤害倍数：2倍</changeText><description>自身无敌[duration]秒，期间逼迫900码内的敌人攻击自己，并把伤害反弹给敌人，伤害等于心零当前武器实际战斗力的2倍。</description></skill>
			</growth>
		</skill>
		<skill name="遇强则刚">
			<name>strongLing</name>
			<cnName>遇强则刚</cnName>
			<effectInfoArr>增加防御力</effectInfoArr>
			<addD pro="mul" range="-2,-5" info="受到伤害降低[v]" />
			<changeText>受到伤害降低[1-mul]</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>interval</condition>
			<target systemType="hero">me,range,we</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType>
			<effectType>strongLing</effectType>
			<mul>0.9</mul>
			<secMul>0.97</secMul>
			<duration>1</duration>
			<range>99999</range>
			<stateEffectImg partType="body" con="add">generalEffect/hurtDefence1</stateEffectImg>
			<description>当目标敌人处于无敌状态时，自己和队友受到伤害降低[1-mul]（不高于90%）、百分比伤害降低[1-secMul]。</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><mul>0.9</mul></skill>
				<skill><mul>0.8</mul></skill>
				<skill><mul>0.7</mul></skill>
				<skill><mul>0.6</mul></skill>
				<skill><mul>0.5</mul></skill>
				<skill><mul>0.4</mul></skill>
				<skill><mul>0.3</mul><secMul>0.85</secMul><changeText>受到百分比伤害降低[1-secMul]</changeText></skill>
				<skill><mul>0.3</mul><secMul>0.70</secMul><changeText>受到百分比伤害降低[1-secMul]</changeText></skill>
				<skill><mul>0.3</mul><secMul>0.50</secMul><changeText>受到百分比伤害降低[1-secMul]</changeText></skill>
				<skill><mul>0.3</mul><secMul>0.30</secMul><changeText>受到百分比伤害降低[1-secMul]</changeText></skill>
			</growth>
		</skill>
		<skill name="复仇">
			<name>revengeLing</name>
			<cnName>复仇</cnName><noBeClearB>1</noBeClearB>
			<effectInfoArr>增加伤害输出</effectInfoArr>
			<addD pro="mul" range="0.01,0.02" info="角色殒命伤害提高[v]" />
			<changeText>英雄角色殒命后造成伤害：[mul]{n}最多造成伤害：[secMul]</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>interval</condition>
			<otherConditionArr>noHardB,noUnendLevelB,noSkillNoTargetMaxLifeB</otherConditionArr>
			<intervalT>1</intervalT>
			<target>me,range,we</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>revengeLingAddSkill</effectType>
			<valueString>revengeLing_link_1</valueString>
			<mul>0.04</mul>
			<secMul>0.08</secMul>
			<duration>99999</duration>
			<range>99999</range>
			<description>我方单位殒命时，对生命值高于20%的凶手造成百分比伤害（角色殒命造成[mul]伤害，其他殒命造成3%伤害），对同个凶手最多造成[secMul]的伤害。99级主线任务中该技能无效。</description>
			<pointEffectImg soundUrl="boomSound/boom">boomEffect/bigFire</pointEffectImg>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><mul>0.03</mul><secMul>0.04</secMul><valueString>revengeLing_link_1</valueString></skill>
				<skill><mul>0.03</mul><secMul>0.08</secMul><valueString>revengeLing_link_2</valueString></skill>
				<skill><mul>0.03</mul><secMul>0.12</secMul><valueString>revengeLing_link_3</valueString></skill>
				<skill><mul>0.03</mul><secMul>0.16</secMul><valueString>revengeLing_link_4</valueString></skill>
				<skill><mul>0.03</mul><secMul>0.20</secMul><valueString>revengeLing_link_5</valueString></skill>
				<skill><mul>0.04</mul><secMul>0.25</secMul><valueString>revengeLing_link_6</valueString></skill>
				<skill><mul>0.05</mul><secMul>0.30</secMul><valueString>revengeLing_link_7</valueString></skill>
				<skill><mul>0.06</mul><secMul>0.35</secMul><valueString>revengeLing_link_8</valueString></skill>
				<skill><mul>0.07</mul><secMul>0.40</secMul><valueString>revengeLing_link_9</valueString></skill>
				<skill><mul>0.08</mul><secMul>0.45</secMul><valueString>revengeLing_link_10</valueString></skill>
			</growth>
		</skill>
