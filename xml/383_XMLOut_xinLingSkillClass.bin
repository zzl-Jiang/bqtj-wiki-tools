		<skill name="暗夜信徒">
			<name>nightLing</name>
			<cnName>暗夜信徒</cnName><everNoClearB>1</everNoClearB>
			<effectInfoArr>增加伤害输出</effectInfoArr>
			<addD pro="mul" range="0.01,0.03" info="继承战斗力[v]" />
			<changeText>增伤或继承战斗力：[mul]{n}不超过自身战斗力的[secMul]</changeText>
