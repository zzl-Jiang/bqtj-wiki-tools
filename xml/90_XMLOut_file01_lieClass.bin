<data id="演习篇-猎人游戏" cnName="演习篇-猎人游戏" author="L刘大将军">
  <info>第一期演习游戏规则：从爆枪小队里抽出三人作为猎物，其余人作为猎人，展开抓捕行动。一天之内，猎人没有抓到所有猎物就算输，猎物也可以向猎人攻击，一方被全歼，另一方获胜！猎物不能携带通讯器，武器只有枪，而猎人有载具，军队以及所有的武器装备。（猎人与猎物都不能使用隐身技能）		推荐：关闭P1的AI功能，默认小白档游玩，其余角色P1档可能会出现bug</info>
  <father name="normal" cn="关卡">
    <gather>
      <level name="演习篇-猎人游戏" cnName="演习篇-猎人游戏" descrip="游戏开始。小樱，小美，文杰作为猎人。主角，藏师，心零作为猎物。">
        <!-- 发兵集************************************************ -->
        <info enemyLv="99" noMoreB="1" noVehicleB="1" noTreasureB="1" noPropsB="1" mustSingleB="1" noDeviceB="1"/>
        <sceneLabel>MainUpland</sceneLabel>
        <!-- 发兵集************************************************ -->
        <unitG>
          <allDefault aiOrder="patrolGlobal" noSuperB="1"/>
          <unitOrder id="we1" camp="we">
            <unit cnName="本我" dpsMul="350" lifeMul="0.5" dieGotoState="stru" armsRange="rifleLock,shotgunLock,sniperLock,pistolLock" skillArr="jumpNumAdd1,State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit cnName="小樱" skillArr="jumpNumAdd1" aiOrder="followBodyAttack:本我"/>
            <unit cnName="文杰表哥" skillArr="jumpNumAdd1" aiOrder="followBodyAttack:小樱"/>
            <unit cnName="藏师将军" aiOrder="followBodyAttack:文杰表哥"/>
            <unit cnName="心零" aiOrder="followBodyAttack:藏师将军"/>
            <unit cnName="天鹰小美" aiOrder="followBodyAttack:小樱"/>
            <unit cnName="制毒师" aiOrder="followBodyAttack:天鹰小美"/>
          </unitOrder>
          <unitOrder id="we3" camp="we">
            <unit cnName="潜影者"/>
          </unitOrder>
          <unitOrder id="we4" camp="we">
            <unit cnName="丛林特种兵" num="5" aiOrder="followBodyAttack:制毒师"/>
            <unit cnName="沙漠特种兵" num="5" aiOrder="followBodyAttack:制毒师"/>
          </unitOrder>
        </unitG>
        <!-- 事件集************************************************ -->
        <eventG>
          <group>
            <event>
              <condition/>
              <order>openInput</order>
              <order>recoverAllHeroHead</order>
              <order>noWearShop</order>
              <order>playMusic; music_face:funny</order>
            </event>
            <event>
              <condition/>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
              <order>createUnit:we1; r_birth</order>
              <order>createUnit:we2; r_birth</order>
              <order>heroEverParasitic:本我</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition>say:listOver</condition>
            </event>
            <event>
              <condition delay="3"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition>say:listOver</condition>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s3</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>createUnit:we3; 393,-45</order>
              <order>body:潜影者; followPoint:700,650</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s4</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>body:藏师将军; rangeLimit:close</order>
              <order>body:藏师将军;followPoint:700,650</order>
              <order>body:心零; rangeLimit:close</order>
              <order>body:心零;followPoint:700,650</order>
            </event>
            <event>
              <condition>bodyGap:less_100; 藏师将军:潜影者</condition>
              <order>body:藏师将军; addEffectPosition:oreBombShowFlower</order>
              <order>body:藏师将军; toDel</order>
            </event>
            <event>
              <condition>bodyGap:less_100; 心零:潜影者</condition>
              <order>body:心零; addEffectPosition:oreBombShowFlower</order>
              <order>body:心零; toDel</order>
            </event>
            <event>
              <condition>bodyGap:less_100; 本我:潜影者</condition>
              <order>body:本我; addEffectPosition:oreBombShowFlower</order>
              <order>body:本我; toDel</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>body:潜影者; rangeLimit:close</order>
              <order>body:潜影者; followPoint:-393,-45</order>
              <order>clearHeroParasitic</order>
              <order>heroEverParasitic:小樱</order>
              <order>playMusic; music_face:funny</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s5</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>createUnit:we4; r_birth</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s6</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>body:文杰表哥; rangeLimit:close</order>
              <order>body:文杰表哥;followPoint:4500,650</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s7</order>
            </event>
            <event id="e2_11">
              <condition>say:listOver</condition>
              <order>task:now; complete</order>
              <order>level; showPointer:r_over</order>
            </event>
          </group>
        </eventG>
      </level>
    </gather>
  </father>
  <father name="normal" cn="关卡">
    <gather>
      <level name="演习篇-潜伏霞光" cnName="演习篇-潜伏霞光" descrip="作为猎物角色的三人开始了潜伏行动。">
        <!-- 发兵集************************************************ -->
        <info enemyLv="99" noMoreB="1" noVehicleB="1" noTreasureB="1" noPropsB="1" mustSingleB="1" noDeviceB="1"/>
        <sceneLabel>BaiZhang</sceneLabel>
        <!-- 发兵集************************************************ -->
        <unitG>
          <allDefault aiOrder="patrolGlobal" noSuperB="1"/>
          <unitOrder id="we1" camp="we">
            <unit cnName="本我" dpsMul="350" lifeMul="0.5" dieGotoState="stru" armsRange="rifleLock,shotgunLock,sniperLock,pistolLock" skillArr="jumpNumAdd1,State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit cnName="藏师将军" aiOrder="followBodyAttack:本我"/>
            <unit cnName="心零" aiOrder="followBodyAttack:本我"/>
          </unitOrder>
          <unitOrder id="we3" camp="we">
            <unit cnName="潜影者"/>
          </unitOrder>
          <unitOrder id="we4" camp="we">
            <unit cnName="判决者"/>
          </unitOrder>
          <unitOrder id="we5" camp="we">
            <unit cnName="潜影者" num="1" aiOrder="followBodyAttack:判决者"/>
          </unitOrder>
          <unitOrder id="we6" camp="we">
            <unit cnName="大鹏" num="1" aiOrder="followBodyAttack:潜影者"/>
          </unitOrder>
        </unitG>
        <!-- 事件集************************************************ -->
        <eventG>
          <group>
            <event>
              <condition/>
              <order>openInput</order>
              <order>recoverAllHeroHead</order>
              <order>noWearShop</order>
            </event>
            <event>
              <condition/>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
              <order>createUnit:we1; r_birth</order>
              <order>createUnit:we2; r_birth</order>
              <order>createUnit:we3; r_birth</order>
              <order>heroEverParasitic:本我</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>body:潜影者; followPoint:4893,-2550</order>
            </event>
            <event>
              <condition delay="3"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>body:本我; playBreak:hideAttack</order>
              <order>body:本我; addEffectPosition:teleport_BoomSkullS_me</order>
              <order>body:藏师将军; playBreak:hideAttack</order>
              <order>body:藏师将军; addEffectPosition:teleport_BoomSkullS_me</order>
              <order>body:心零; playBreak:hideAttack</order>
              <order>body:心零; addEffectPosition:teleport_BoomSkullS_me</order>
            </event>
            <event>
              <order>body:本我; toDel</order>
              <order>body:藏师将军; toDel</order>
              <order>body:心零; toDel</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>createUnit:we4; -793,-1050</order>
              <order>createUnit:we5; -793,-850</order>
              <order>createUnit:we6; -793,-950</order>
              <order>clearHeroParasitic</order>
              <order>heroEverParasitic:判决者</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s3</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>task:now; complete</order>
              <order>level; showPointer:r_over</order>
            </event>
          </group>
        </eventG>
      </level>
    </gather>
  </father>
  <father name="normal" cn="关卡">
    <gather>
      <level name="演习篇-严阵以待" cnName="演习篇-严阵以待" descrip="猎人比猎物先到西峰一步。">
