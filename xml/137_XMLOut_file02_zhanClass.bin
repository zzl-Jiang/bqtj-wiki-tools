<data id="演习篇-斩首行动" cnName="演习篇-斩首行动" author="L刘大将军">
  <info>第二期演习游戏规则：制毒师担任爆枪小队的首领，作为红方军队。亚瑟担任天鹰军团的司令，作为蓝方军队。
双方各率领自己的部队在霞光大陆展开演习对决。完成主要任务的军队获胜。（由于红军数量小于蓝军数量，双方的任务要求有所不同。红军的主要任务是击毙蓝军司令，蓝军的主要任务是抓到所有的红军。）
		推荐：关闭P1的AI功能，默认小白档游玩，其余角色P1档可能会出现bug</info>
  <father name="normal" cn="关卡">
    <gather>
      <level name="演习篇-斩首行动" cnName="演习篇-斩首行动" descrip="演习开始。红蓝军队相继选择在霞光大陆最适合的地点作为基地。">
        <!-- 发兵集************************************************ -->
        <info enemyLv="99" noMoreB="1" noVehicleB="1" noTreasureB="1" noPropsB="1" mustSingleB="1" noDeviceB="1"/>
        <sceneLabel>MainUpland</sceneLabel>
        <!-- 发兵集************************************************ -->
        <unitG>
          <allDefault aiOrder="patrolGlobal" noSuperB="1"/>
          <unitOrder id="we1" camp="we">
            <unit cnName="本我" dpsMul="350" lifeMul="0.5" dieGotoState="stru" armsRange="rifleLock,shotgunLock,sniperLock,pistolLock" skillArr="jumpNumAdd1,State_AddMove50"/>
          </unitOrder>
          <unitOrder id="we2" camp="we">
            <unit cnName="小樱" skillArr="jumpNumAdd1" aiOrder="followBodyAttack:本我"/>
            <unit cnName="文杰表哥" aiOrder="followBodyAttack:小樱"/>
            <unit cnName="藏师将军" aiOrder="followBodyAttack:文杰表哥"/>
            <unit cnName="心零" aiOrder="followBodyAttack:藏师将军"/>
            <unit cnName="天鹰小美" aiOrder="followBodyAttack:亚瑟"/>
            <unit cnName="制毒师" aiOrder="followBodyAttack:本我"/>
            <unit cnName="亚瑟" aiOrder="followBodyAttack:制毒师"/>
            <unit cnName="奇皇博士" aiOrder="followBodyAttack:亚瑟"/>
          </unitOrder>
          <unitOrder id="we3" camp="we">
            <unit cnName="处决者"/>
          </unitOrder>
          <unitOrder id="we4" camp="we">
            <unit id="u4" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we5" camp="we">
            <unit id="u5" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we6" camp="we">
            <unit id="u6" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we7" camp="we">
            <unit id="u7" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we8" camp="we">
            <unit id="u8" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we9" camp="we">
            <unit id="u9" cnName="处决者" unitType="boss"/>
          </unitOrder>
          <unitOrder id="we10" camp="we">
            <unit cnName="摩卡"/>
            <unit cnName="雇佣兵" aiOrder="followBodyAttack:摩卡"/>
          </unitOrder>
        </unitG>
        <rectG>
          <rect id="y4">80,405,1,1</rect>
          <rect id="y5">309 ,344,1,1</rect>
          <rect id="y6">697 ,405,1,1</rect>
          <rect id="y7">1068 ,344,1,1</rect>
          <rect id="y8">1424 ,405,1,1</rect>
          <rect id="y9">1818 ,344,1,1</rect>
        </rectG>
        <!-- 事件集************************************************ -->
        <eventG>
          <group>
            <event>
              <condition/>
              <order>openInput</order>
              <order>recoverAllHeroHead</order>
              <order>noWearShop</order>
              <order>playMusic; music_face:funny</order>
            </event>
            <event>
              <condition/>
              <order>weAllHeroNoShoot</order>
              <order>weAllHeroNoEquip</order>
              <order>createUnit:we1; r_birth</order>
              <order>createUnit:we2; r_birth</order>
              <order>heroEverParasitic:本我</order>
            </event>
            <event>
              <condition delay="1"/>
              <order>say; startList:s1</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>createUnit:we4;-393,-45</order>
              <order>body:u4; followPoint:y4</order>
              <order>createUnit:we5;-393,-45</order>
              <order>body:u5; followPoint:y5</order>
              <order>createUnit:we6;-393,-45</order>
              <order>body:u6; followPoint:y6</order>
              <order>createUnit:we7;-393,-45</order>
              <order>body:u7; followPoint:y7</order>
              <order>createUnit:we8;-393,-45</order>
              <order>body:u8; followPoint:y8</order>
              <order>createUnit:we9; 393,-45</order>
              <order>body:u9; followPoint:y9</order>
              <order>createUnit:we3; 393,-45</order>
              <order>body:处决者; followPoint:700,650</order>
            </event>
            <event>
              <condition delay="3"/>
              <order>say; startList:s2</order>
            </event>
            <event>
              <condition>say:listOver</condition>
              <order>body:藏师将军; rangeLimit:close</order>
              <order>body:藏师将军;followPoint:700,650</order>
              <order>body:心零; rangeLimit:close</order>
              <order>body:心零;followPoint:700,650</order>
              <order>body:小樱; rangeLimit:close</order>
              <order>body:小樱;followPoint:700,650</order>
              <order>body:文杰表哥; rangeLimit:close</order>
              <order>body:文杰表哥;followPoint:700,650</order>
              <order>body:制毒师; rangeLimit:close</order>
              <order>body:制毒师;followPoint:700,650</order>
            </event>
            <event>
              <condition>bodyGap:less_70; 小樱:处决者</condition>
              <order>body:小樱; addEffectPosition:oreBombShowFlower</order>
              <order>body:小樱; toDel</order>
            </event>
            <event>
              <condition>bodyGap:less_70; 文杰表哥:处决者</condition>
              <order>body:文杰表哥; addEffectPosition:oreBombShowFlower</order>
              <order>body:文杰表哥; toDel</order>
            </event>
            <event>
              <condition>bodyGap:less_70; 藏师将军:处决者</condition>
