<?xml version="1.0" encoding="utf-8" ?>
<data>
	<father type="lightning">
		<bullet color="purgold" sightMul="2" evoMaxLv="2" evoMustFirstLv="13" composeLv="99" chipNum="300">
			<name>electricCurve</name><extraMul>1</extraMul>
			<cnName>电弧</cnName>
			<dpsMul>0.3</dpsMul><uiDpsMul>1.17</uiDpsMul>
			<aiShootRange>1200</aiShootRange><!-- ai射程 -->
			<attackType>holy</attackType>
			<iconUrl>newGun/electricCurveIcon</iconUrl>
			<!--基本-->
			<capacity>20</capacity>
			<attackGap>0.8</attackGap>
			<reloadGap>2</reloadGap>
			<bulletWidth>25</bulletWidth>
			<bulletNum>1</bulletNum>				
			<shootAngle>1</shootAngle>
			<shakeAngle>13</shakeAngle>
			<noShakeTime>0.5</noShakeTime>
			<!--武器属性------------------------------------------------------------ -->
			<armsArmMul>0.5</armsArmMul>
			<upValue>10</upValue>
			<shootShakeAngle>30</shootShakeAngle>
			<shootRecoil>5</shootRecoil>
			<screenShakeValue>9</screenShakeValue>
			<!--基本属性------------------------------------------------------------ -->
			<noHitB>1</noHitB>
			<bulletLife>4</bulletLife>
			<hitType>rect</hitType>
			<!--运动属性------------------------------------------------------------ -->	
			<bulletSpeed>0</bulletSpeed>
			<bulletSkillArr>electricArcSunPRE</bulletSkillArr>
			<!--特殊------------------------------------------------------------ -->
			<boomD selfB="1"/>
			<penetrationNum>999</penetrationNum>
			<penetrationGap>1000</penetrationGap>
			<skillArr>Hit_SlowMove_ArmsSkill,Kill_Spurting_ArmsSkill</skillArr>
			<godSkillArr>superHitSlow,electricCurveSkill</godSkillArr>
			<!--图像动画属性------------------------------------------------------------ -->
			<shootSoundUrl>sound/lightningShoot</shootSoundUrl>
			<bulletImgUrl name="electricArcBullet"/>
			<selfBoomImgUrl name="yearDragon_hit"/>
			<!--图像范围------------------------------------------------------------ -->
			<bodyImgRange>newGun/electricCurve</bodyImgRange>
			<bulletImgRange>specialGun/bullet</bulletImgRange>
			<info></info>
		</bullet>
		
		
		
	</father>
	<father name="godArmsSkill" cnName="神级武器技能">
		<skill>
			<name>electricCurveSkill</name>
			<cnName>电弧链接</cnName><noRandomListB>1</noRandomListB><ignoreNoSkillB>1</ignoreNoSkillB>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>passive</conditionType>
			<condition>beforeAttack</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instant</addType>
			<effectType>armsToMousePoint</effectType>
			<otherEffectImg name="consVirgoLine"/>
			<description>发射时，把子弹瞬移到鼠标点位置。前后2颗子弹之间将产生电弧，持续对敌人造成伤害。子弹本体没有伤害。</description>
		</skill>
	</father>
</data>